NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Necessárias só para a gravação/resumo de aulas com IA (Recall.ai + Claude).
# Nunca prefixe estas com NEXT_PUBLIC_ - são secrets só de servidor.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RECALL_API_KEY=your-recall-api-key
# Região da sua conta Recall.ai (us-east-1, us-west-2, eu-central-1 ou
# ap-northeast-1). Confira no dashboard do Recall.ai - a chave só funciona
# na região em que a conta foi criada.
RECALL_REGION=us-west-2
# O "Verification Secret" (whsec_...) do dashboard do Recall.ai (Developers
# > API Keys & Secrets), NAO uma string inventada. Registre tambem a URL
# https://SEU-DOMINIO/api/recall/webhook no dashboard deles em Webhooks.
RECALL_WEBHOOK_SECRET=whsec_...
ANTHROPIC_API_KEY=your-anthropic-api-key
